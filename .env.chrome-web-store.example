# Copy this file to `.env.chrome-web-store.local` and fill in your Chrome Web Store API credentials.
# This local file is gitignored and can be used for local publishing without GitHub Actions.
#
# Required in all cases:
CWS_PUBLISHER_ID=your_publisher_id
CWS_EXTENSION_ID=your_extension_id
#
# Choose one auth mode:
#
# 1) Recommended for local use: gcloud impersonation
#    Prerequisites:
#    - `gcloud auth login`
#    - your user can impersonate the service account
# CWS_SERVICE_ACCOUNT_EMAIL=chrome-web-store-publisher@your-project.iam.gserviceaccount.com
#
# 2) Service account JSON key file
#    Store the key outside git, then point to it here.
# CWS_SERVICE_ACCOUNT_KEY_FILE=/absolute/path/to/service-account-key.json
#
# 3) Inline JSON credentials (required for GitHub Actions)
# CWS_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}
#
# 4) Pre-supplied short-lived access token
# CWS_ACCESS_TOKEN=ya29....
#
# Optional publish controls:
# CWS_PUBLISH_TYPE=DEFAULT_PUBLISH
# CWS_SKIP_REVIEW=false
# CWS_BLOCK_ON_WARNINGS=false
# CWS_DEPLOY_PERCENTAGE=5
