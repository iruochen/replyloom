{
  "name": "reply-loom",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "package": "npm run version:check && npm run build && node scripts/package-extension.mjs",
    "version:check": "node scripts/verify-extension-version.mjs",
    "version:bump:patch": "node scripts/bump-extension-version.mjs patch",
    "version:bump:minor": "node scripts/bump-extension-version.mjs minor",
    "version:bump:major": "node scripts/bump-extension-version.mjs major",
    "publish:chrome-store": "npm run package && node scripts/publish-chrome-web-store.mjs",
    "publish:chrome-store:dry-run": "npm run package && node scripts/publish-chrome-web-store.mjs --dry-run",
    "publish:chrome-store:status": "node scripts/publish-chrome-web-store.mjs --status",
    "publish:chrome-store:upload-only": "npm run package && node scripts/publish-chrome-web-store.mjs --upload-only",
    "video:studio": "remotion studio video/src/index.ts --public-dir=video/public",
    "video:still": "remotion still video/src/index.ts ReplyLoomPromo store-assets/video/thumbnail-1920x1080.png --frame=210 --public-dir=video/public",
    "store:top-promo": "remotion still video/src/index.ts ReplyLoomTopPromo store-assets/promos/marquee-1400x560.jpg --image-format=jpeg --jpeg-quality=95 --public-dir=video/public",
    "video:render": "remotion render video/src/index.ts ReplyLoomPromo store-assets/video/demo-1920x1080.mp4 --codec=h264 --crf=18 --public-dir=video/public",
    "test": "vitest run",
    "test:live:minimax": "RUN_LIVE_MINIMAX_TESTS=1 vitest run --testNamePattern=\"fixed live tweet fixture\"",
    "test:live:provider": "RUN_LIVE_PROVIDER_TESTS=1 vitest run --testNamePattern=\"real provider\"",
    "test:watch": "vitest",
    "check": "npm run version:check && npm run test && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.482",
    "@remotion/transitions": "^4.0.482",
    "@types/chrome": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "remotion": "^4.0.482",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
